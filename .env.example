# FinPilot Local Environment Configuration Template

# Application Settings
APP_NAME=finpilot-backend
APP_ENV=development
DEBUG=True

# Security
SECRET_KEY=change-this-in-production-super-secret-key-12345
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
POSTGRES_USER=finpilot_user
POSTGRES_PASSWORD=finpilot_password
POSTGRES_DB=finpilot_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://finpilot_user:finpilot_password@localhost:5432/finpilot_db

# Local Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct-q4_K_M
OLLAMA_TIMEOUT=120

# Remote API LLM Fallback (Optional)
API_FALLBACK_ENABLED=True
API_LLM_PROVIDER=openai_compatible
API_LLM_MODEL=gpt-3.5-turbo
API_LLM_API_KEY=
API_LLM_BASE_URL=https://api.openai.com/v1
