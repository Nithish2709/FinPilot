# FinPilot Environment Configuration Example

# Application Settings
APP_NAME=finpilot-backend
APP_ENV=development
DEBUG=True

# Security
SECRET_KEY=change-this-in-production-super-secret-key-12345
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
POSTGRES_USER=finpilot_user
POSTGRES_PASSWORD=finpilot_password
POSTGRES_DB=finpilot_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}
